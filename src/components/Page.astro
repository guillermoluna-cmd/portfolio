---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { content, profile, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = content[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otherHref = lang === 'es' ? `${base}/en/` : `${base}/`;
const callHref = profile.calendly || `mailto:${profile.email}?subject=${encodeURIComponent(lang === 'es' ? 'Llamada de diagnóstico' : 'Discovery call')}`;
const year = new Date().getFullYear();

const serviceStyle: Record<string, { icon: string; accent: string; text: string }> = {
  dev: { icon: 'code', accent: 'var(--violet)', text: 'text-violet' },
  ai: { icon: 'sparkles', accent: 'var(--cyan)', text: 'text-cyan' },
  sales: { icon: 'handshake', accent: 'var(--amber)', text: 'text-amber' },
};
const caseIcons = ['chat', 'inbox', 'file', 'chart'];
const navItems = [
  { href: '#services', label: t.nav.services },
  { href: '#process', label: t.nav.process },
  { href: '#work', label: t.nav.work },
  { href: '#about', label: t.nav.about },
  { href: '#faq', label: t.nav.faq },
];
const clients = ['Arteche', 'Aegon', 'SegurCaixa Adeslas', 'MAPFRE', 'NFQ'];
const flow =
  lang === 'es'
    ? [
        { icon: 'inbox', label: 'Nuevo lead', sub: 'Formulario web' },
        { icon: 'bot', label: 'IA cualifica', sub: 'Puntuación 92/100' },
        { icon: 'database', label: 'CRM actualizado', sub: 'Contacto creado' },
        { icon: 'mail', label: 'Respuesta enviada', sub: 'En 4 segundos' },
      ]
    : [
        { icon: 'inbox', label: 'New lead', sub: 'Website form' },
        { icon: 'bot', label: 'AI qualifies', sub: 'Score 92/100' },
        { icon: 'database', label: 'CRM updated', sub: 'Contact created' },
        { icon: 'mail', label: 'Reply sent', sub: 'In 4 seconds' },
      ];
---

<Layout lang={lang}>
  <!-- NAV -->
  <header id="nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
    <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href="#top" class="font-display text-lg font-bold tracking-tight">
        Desvelo<span class="text-gradient"> Labs</span>
      </a>
      <ul class="hidden items-center gap-8 text-sm text-muted md:flex">
        {navItems.map((n) => <li><a href={n.href} class="transition hover:text-fg">{n.label}</a></li>)}
      </ul>
      <div class="flex items-center gap-2">
        <a href={otherHref} class="rounded-full border border-line px-3 py-1.5 text-xs font-semibold text-muted transition hover:border-line-strong hover:text-fg" aria-label={t.switchLangLabel} hreflang={lang === 'es' ? 'en' : 'es'}>
          {t.switchLang}
        </a>
        <button id="theme-toggle" class="grid size-9 place-items-center rounded-full border border-line text-muted transition hover:border-line-strong hover:text-fg" aria-label={t.themeLabel}>
          <span class="theme-dark"><Icon name="sun" class="size-4" /></span>
          <span class="theme-light hidden"><Icon name="moon" class="size-4" /></span>
        </button>
        <a href="#contact" class="btn-primary hidden rounded-full px-4 py-2 text-sm font-semibold sm:inline-block">{t.nav.cta}</a>
        <button id="menu-toggle" class="grid size-9 place-items-center rounded-full border border-line text-muted md:hidden" aria-label={t.menuLabel} aria-expanded="false" aria-controls="mobile-menu">
          <Icon name="menu" class="size-4" />
        </button>
      </div>
    </nav>
    <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 backdrop-blur-xl md:hidden">
      <ul class="flex flex-col px-4 py-4 text-base">
        {navItems.map((n) => <li><a href={n.href} class="block py-3 text-muted hover:text-fg">{n.label}</a></li>)}
        <li><a href="#contact" class="btn-primary mt-3 block rounded-full px-4 py-3 text-center font-semibold">{t.nav.cta}</a></li>
      </ul>
    </div>
  </header>

  <main id="top">
    <!-- HERO -->
    <section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-28">
      <div class="bg-grid absolute inset-0"></div>
      <div class="glow -top-40 left-1/4 size-[520px] bg-violet"></div>
      <div class="glow top-20 -right-40 size-[420px] bg-cyan"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.15fr_1fr]">
        <div>
          <div class="reveal inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-medium text-muted">
            <span class="relative flex size-2">
              <span class="ping absolute inline-flex size-full rounded-full bg-emerald-400"></span>
              <span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span>
            </span>
            {t.hero.badge}
          </div>
          <h1 class="reveal font-display mt-6 text-4xl leading-[1.05] font-bold tracking-tight sm:text-6xl" style="--d:100ms">
            {t.hero.titleA}<br />
            <span class="text-muted">{t.hero.titleB}</span><br />
            <span class="rotator text-gradient" data-rotator>
              {t.hero.rotating.map((w, i) => <span class={i === 0 ? 'active' : ''}>{w}</span>)}
            </span>
          </h1>
          <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-muted sm:text-lg" style="--d:200ms">{t.hero.subtitle}</p>
          <div class="reveal mt-8 flex flex-col gap-3 sm:flex-row" style="--d:300ms">
            <a href={callHref} target={profile.calendly ? '_blank' : undefined} rel="noopener" class="btn-primary inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 font-semibold">
              <Icon name="calendar" class="size-4" />{t.hero.primary}
            </a>
            <a href="#services" class="inline-flex items-center justify-center gap-2 rounded-full border border-line-strong px-6 py-3.5 font-semibold transition hover:bg-surface">
              {t.hero.secondary}<Icon name="arrow" class="size-4" />
            </a>
          </div>
        </div>

        <!-- Flow visual -->
        <div class="reveal float relative" style="--d:400ms">
          <div class="card relative p-5 sm:p-6 sm:pb-14">
            <div class="mb-5 flex items-center justify-between">
              <div class="flex gap-1.5">
                <span class="size-2.5 rounded-full bg-red-400/70"></span>
                <span class="size-2.5 rounded-full bg-amber-400/70"></span>
                <span class="size-2.5 rounded-full bg-emerald-400/70"></span>
              </div>
              <span class="font-mono text-[11px] text-faint">automation.flow</span>
            </div>
            <ol class="space-y-0">
              {flow.map((s, i) => (
                <li>
                  <div class="flex items-center gap-4 rounded-xl border border-line bg-surface-strong p-3.5">
                    <div class="grid size-10 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-violet/25 to-cyan/25 text-cyan">
                      <Icon name={s.icon} class="size-5" />
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="text-sm font-semibold">{s.label}</p>
                      <p class="truncate text-xs text-muted">{s.sub}</p>
                    </div>
                    <Icon name="check" class="size-4 text-emerald-400" />
                  </div>
                  {i < flow.length - 1 && <div class="flow-line ml-8 h-5 w-px" style={`--d:${i * 0.6}s`}></div>}
                </li>
              ))}
            </ol>
          </div>
          <div class="card absolute -bottom-6 -left-4 hidden items-center gap-3 px-4 py-3 sm:flex">
            <Icon name="bolt" class="size-5 text-amber" />
            <div>
              <p class="font-display text-lg leading-none font-bold">-12h</p>
              <p class="text-[11px] text-muted">{lang === 'es' ? 'trabajo manual / semana' : 'manual work / week'}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Stats -->
      <div class="relative mx-auto mt-20 max-w-6xl px-4 sm:px-6">
        <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line lg:grid-cols-4">
          {t.hero.stats.map((s, i) => (
            <div class="reveal bg-bg p-6 text-center" style={`--d:${i * 80}ms`}>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-4xl font-bold tracking-tight text-gradient sm:text-5xl">{s.value}</dd>
              <dd class="mt-1 text-sm text-muted">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- CLIENTS MARQUEE -->
    <section class="border-y border-line py-8" aria-label={t.trusted}>
      <p class="mb-5 text-center text-xs font-semibold tracking-[0.16em] text-faint uppercase">{t.trusted}</p>
      <div class="relative overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_15%,#000_85%,transparent)]">
        <div class="marquee flex w-max gap-16 pr-16">
          {[...clients, ...clients, ...clients, ...clients].map((c) => (
            <span class="font-display text-xl font-semibold whitespace-nowrap text-muted/70 sm:text-2xl">{c}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="relative py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="reveal eyebrow">{t.services.eyebrow}</p>
          <h2 class="reveal font-display mt-4 text-3xl font-bold tracking-tight sm:text-5xl">{t.services.title}</h2>
          <p class="reveal mt-4 text-lg text-muted">{t.services.intro}</p>
        </div>
        <div class="mt-14 grid gap-6 lg:grid-cols-3">
          {t.services.items.map((s, i) => {
            const st = serviceStyle[s.key];
            return (
              <article class="reveal card card-hover group relative flex flex-col overflow-hidden p-7" style={`--d:${i * 120}ms; --accent:${st.accent}`}>
                <div class="absolute inset-x-0 top-0 h-px" style={`background:linear-gradient(90deg,transparent,${st.accent},transparent)`}></div>
                <div class="flex items-center justify-between">
                  <div class={`grid size-12 place-items-center rounded-xl border border-line ${st.text}`} style={`background:color-mix(in srgb, ${st.accent} 12%, transparent)`}>
                    <Icon name={st.icon} class="size-6" />
                  </div>
                  <span class="rounded-full border border-line px-2.5 py-1 text-[11px] font-medium text-muted">{s.tag}</span>
                </div>
                <h3 class="font-display mt-6 text-2xl font-bold">{s.title}</h3>
                <p class="mt-3 text-muted">{s.desc}</p>
                <ul class="mt-6 space-y-3 border-t border-line pt-6 text-sm">
                  {s.points.map((p) => (
                    <li class="flex gap-3">
                      <Icon name="check" class={`mt-0.5 size-4 shrink-0 ${st.text}`} />
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
                <a href="#contact" class={`mt-8 inline-flex items-center gap-2 text-sm font-semibold ${st.text}`}>
                  {t.nav.cta}<Icon name="arrow" class="size-4 transition group-hover:translate-x-1" />
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="relative border-t border-line bg-bg-2 py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="reveal eyebrow">{t.process.eyebrow}</p>
        <h2 class="reveal font-display mt-4 max-w-2xl text-3xl font-bold tracking-tight sm:text-5xl">{t.process.title}</h2>
        <ol class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {t.process.steps.map((s, i) => (
            <li class="reveal relative" style={`--d:${i * 120}ms`}>
              <div class="flex items-center gap-4">
                <span class="font-display text-gradient text-5xl font-bold">0{i + 1}</span>
                {i < t.process.steps.length - 1 && <span class="hidden h-px flex-1 bg-gradient-to-r from-line-strong to-transparent lg:block"></span>}
              </div>
              <h3 class="font-display mt-4 text-xl font-semibold">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- WORK -->
    <section id="work" class="relative py-24 sm:py-32">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="max-w-2xl">
          <p class="reveal eyebrow">{t.work.eyebrow}</p>
          <h2 class="reveal font-display mt-4 text-3xl font-bold tracking-tight sm:text-5xl">{t.work.title}</h2>
          <p class="reveal mt-4 text-lg text-muted">{t.work.intro}</p>
        </div>
        <div class="mt-14 grid gap-6 md:grid-cols-2">
          {t.work.projects.map((p, i) => (
            <article class="reveal card card-hover relative overflow-hidden p-7" style={`--d:${(i % 2) * 120}ms`}>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="font-display text-lg font-bold">{p.client}</span>
                <span class="text-xs font-medium text-cyan">{p.sector}</span>
              </div>
              <h3 class="mt-4 text-xl font-semibold">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.desc}</p>
              <ul class="mt-6 flex flex-wrap gap-2">
                {p.tech.map((x) => <li class="rounded-md border border-line bg-surface-strong px-2 py-1 font-mono text-[11px] text-muted">{x}</li>)}
              </ul>
            </article>
          ))}
        </div>

        <div class="mt-24">
          <h3 class="reveal font-display text-2xl font-bold tracking-tight sm:text-3xl">{t.work.casesTitle}</h3>
          <p class="reveal mt-2 text-sm text-faint">{t.work.casesNote}</p>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {t.work.cases.map((c, i) => (
              <article class="reveal card card-hover flex flex-col p-6" style={`--d:${i * 100}ms; --accent: var(--cyan)`}>
                <div class="grid size-10 place-items-center rounded-lg bg-cyan/10 text-cyan">
                  <Icon name={caseIcons[i]} class="size-5" />
                </div>
                <h4 class="mt-5 font-semibold">{c.title}</h4>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{c.desc}</p>
                <p class="mt-5 flex items-center gap-2 border-t border-line pt-4 text-xs font-medium text-emerald-400">
                  <Icon name="bolt" class="size-3.5" />{c.result}
                </p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="relative border-t border-line bg-bg-2 py-24 sm:py-32">
      <div class="mx-auto grid max-w-6xl gap-16 px-4 sm:px-6 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <p class="reveal eyebrow">{t.about.eyebrow}</p>
          <h2 class="reveal font-display mt-4 text-3xl font-bold tracking-tight sm:text-5xl">{t.about.title}</h2>
          <div class="reveal mt-8 flex items-center gap-5">
            <!-- Sustituir por foto: <img src={`${base}/guillermo.jpg`} ... /> -->
            <div class="relative grid size-24 shrink-0 place-items-center rounded-2xl bg-gradient-to-br from-violet to-cyan p-[2px]">
              <div class="font-display grid size-full place-items-center rounded-[14px] bg-bg text-3xl font-bold">GL</div>
            </div>
            <div>
              <p class="font-display text-xl font-bold">{profile.fullName}</p>
              <p class="text-sm text-muted">{lang === 'es' ? 'Fundador de Desvelo Labs · Ingeniero de Telecomunicación' : 'Founder of Desvelo Labs · Telecommunications Engineer'}</p>
              <p class="mt-1 flex items-center gap-1.5 text-sm text-faint"><Icon name="pin" class="size-3.5" />{lang === 'es' ? 'España · Remoto' : 'Spain · Remote'}</p>
            </div>
          </div>
          {t.about.paragraphs.map((p) => <p class="reveal mt-6 leading-relaxed text-muted">{p}</p>)}

          <h3 class="reveal font-display mt-12 text-lg font-semibold">{t.about.stackTitle}</h3>
          <div class="mt-5 space-y-4">
            {t.about.stack.map((g) => (
              <div class="reveal">
                <p class="mb-2 text-xs font-semibold tracking-wider text-faint uppercase">{g.group}</p>
                <ul class="flex flex-wrap gap-2">
                  {g.items.map((x) => <li class="rounded-full border border-line bg-surface px-3 py-1 text-sm">{x}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="space-y-12">
          <div>
            <h3 class="reveal font-display text-lg font-semibold">{t.about.experienceTitle}</h3>
            <ol class="relative mt-6 space-y-6 border-l border-line pl-6">
              {t.about.experience.map((e, i) => (
                <li class="reveal relative" style={`--d:${i * 100}ms`}>
                  <span class="absolute top-1.5 -left-[31px] size-3 rounded-full border-2 border-bg-2 bg-gradient-to-br from-violet to-cyan"></span>
                  <p class="text-xs font-medium text-cyan">{e.period}</p>
                  <p class="mt-1 font-semibold">{e.role}</p>
                  <p class="text-sm text-muted">{e.company}</p>
                </li>
              ))}
            </ol>
          </div>
          <div>
            <h3 class="reveal font-display text-lg font-semibold">{t.about.educationTitle}</h3>
            <ol class="relative mt-6 space-y-6 border-l border-line pl-6">
              {t.about.education.map((e, i) => (
                <li class="reveal relative" style={`--d:${i * 100}ms`}>
                  <span class="absolute top-1.5 -left-[31px] size-3 rounded-full border-2 border-bg-2 bg-line-strong"></span>
                  <p class="text-xs font-medium text-faint">{e.period}</p>
                  <p class="mt-1 font-semibold">{e.title}</p>
                  <p class="text-sm text-muted">{e.place}</p>
                </li>
              ))}
            </ol>
          </div>

          <!-- LANGUAGES -->
          <div id="languages" class="reveal card p-7">
            <div class="flex items-center gap-3">
              <Icon name="globe" class="size-5 text-cyan" />
              <h3 class="font-display text-lg font-semibold">{t.languages.title}</h3>
            </div>
            <ul class="mt-6 space-y-5">
              {t.languages.items.map((l) => (
                <li>
                  <div class="flex items-baseline justify-between text-sm">
                    <span class="font-semibold">{l.name}</span>
                    <span class="text-muted">{l.level}</span>
                  </div>
                  <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
                    <div class="lang-bar h-full rounded-full bg-gradient-to-r from-violet to-cyan" style={`--w:${l.value}%`}></div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="mt-6 border-t border-line pt-5 text-sm text-muted">{t.languages.remote}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="py-24 sm:py-32">
      <div class="mx-auto max-w-3xl px-4 sm:px-6">
        <p class="reveal eyebrow">{t.faq.eyebrow}</p>
        <h2 class="reveal font-display mt-4 text-3xl font-bold tracking-tight sm:text-5xl">{t.faq.title}</h2>
        <div class="mt-12 divide-y divide-line border-y border-line">
          {t.faq.items.map((f) => (
            <details class="reveal group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-6 text-left font-semibold">
                {f.q}
                <span class="faq-icon grid size-8 shrink-0 place-items-center rounded-full border border-line text-muted transition-transform duration-300">
                  <Icon name="plus" class="size-4" />
                </span>
              </summary>
              <p class="mt-3 pr-12 leading-relaxed text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="px-4 pb-24 sm:px-6 sm:pb-32">
      <div class="reveal relative mx-auto max-w-6xl overflow-hidden rounded-3xl border border-line bg-surface-strong px-6 py-16 text-center sm:px-12 sm:py-24">
        <div class="glow -top-32 left-1/2 size-[420px] -translate-x-1/2 bg-violet"></div>
        <div class="bg-grid absolute inset-0"></div>
        <div class="relative">
          <p class="eyebrow justify-center">{t.contact.eyebrow}</p>
          <h2 class="font-display mx-auto mt-4 max-w-2xl text-3xl font-bold tracking-tight sm:text-5xl">{t.contact.title}</h2>
          <p class="mx-auto mt-4 max-w-xl text-lg text-muted">{t.contact.subtitle}</p>
          <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
            <a href={`mailto:${profile.email}`} class="btn-primary inline-flex w-full items-center justify-center gap-2 rounded-full px-6 py-3.5 font-semibold sm:w-auto">
              <Icon name="mail" class="size-4" />{t.contact.email}
            </a>
            <a href={callHref} target={profile.calendly ? '_blank' : undefined} rel="noopener" class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-line-strong px-6 py-3.5 font-semibold transition hover:bg-surface sm:w-auto">
              <Icon name="calendar" class="size-4" />{t.contact.call}
            </a>
          </div>
          <button id="copy-email" data-email={profile.email} data-copied={t.contact.copied} class="mt-6 inline-flex items-center gap-2 font-mono text-sm text-muted transition hover:text-fg">
            <Icon name="copy" class="size-4" /><span>{profile.email}</span>
          </button>
          <div class="mt-8 flex justify-center gap-3">
            {profile.linkedin && (
              <a href={profile.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid size-11 place-items-center rounded-full border border-line text-muted transition hover:border-line-strong hover:text-fg"><Icon name="linkedin" class="size-5" /></a>
            )}
            {profile.github && (
              <a href={profile.github} target="_blank" rel="noopener" aria-label="GitHub" class="grid size-11 place-items-center rounded-full border border-line text-muted transition hover:border-line-strong hover:text-fg"><Icon name="github" class="size-5" /></a>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 text-sm text-faint sm:flex-row sm:px-6">
      <p>© {year} {profile.brand} · {profile.fullName}. {t.footer.rights}</p>
      <p>{t.footer.built}</p>
    </div>
  </footer>

  <style>
    .lang-bar { width: 0; transition: width 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) 0.2s; }
    :global(.in) .lang-bar, :global(.no-js) .lang-bar { width: var(--w); }
    :global([data-theme='light']) .theme-dark { display: none; }
    :global([data-theme='light']) .theme-light { display: inline; }
    #nav.scrolled { background: color-mix(in srgb, var(--bg) 80%, transparent); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); }
  </style>

  <script>
    // Reveal on scroll
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Nav background on scroll
    const nav = document.getElementById('nav')!;
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 10);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu
    const menuBtn = document.getElementById('menu-toggle')!;
    const menu = document.getElementById('mobile-menu')!;
    menuBtn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      menuBtn.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      menu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
    }));

    // Theme toggle
    document.getElementById('theme-toggle')!.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    });

    // Rotating words
    const rot = document.querySelector('[data-rotator]');
    if (rot && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const words = Array.from(rot.children);
      let i = 0;
      setInterval(() => {
        words[i].classList.remove('active');
        i = (i + 1) % words.length;
        words[i].classList.add('active');
      }, 2600);
    }

    // Copy email
    const copyBtn = document.getElementById('copy-email') as HTMLButtonElement;
    copyBtn.addEventListener('click', async () => {
      const label = copyBtn.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(copyBtn.dataset.email!);
        const prev = label.textContent;
        label.textContent = copyBtn.dataset.copied!;
        setTimeout(() => (label.textContent = prev), 1800);
      } catch {}
    });
  </script>
</Layout>
